-   "source": "# ── Materialise the concrete prompt set → prompts.jsonl ────────────────────\n# nb02 freezes *what to ask*; nb03 only has to load this file and decode.\n# Each line is one generation \"call\" with the fully-rendered system prompt,\n# a deterministic job_id (so nb03 can resume), and a per-call seed.\nimport random\nfrom collections import Counter\n\nassert N_TOPICS_PER_EMOTION <= len(TOPICS_100), \"not enough topics to sample without replacement\"\n\ndef _job_id(*parts):\n    return hashlib.sha1(\"|\".join(map(str, parts)).encode(\"utf-8\")).hexdigest()[:10]\n\nrng = random.Random(SEED_BASE)\njobs = []\n\n# (1) Emotion stories — each emotion gets N_TOPICS_PER_EMOTION distinct topics.\nfor ei, emotion in enumerate(EMOTIONS_171):\n    for ti in rng.sample(range(len(TOPICS_100)), N_TOPICS_PER_EMOTION):\n        jobs.append({\n            \"kind\": \"emotion_story\",\n            \"job_id\": _job_id(\"emotion_story\", spec_hash, emotion, ti),\n            \"emotion\": emotion, \"emotion_idx\": ei,\n            \"topic\": TOPICS_100[ti], \"topic_idx\": ti,\n            \"n_outputs\": N_STORIES_PER_CALL,\n            \"system_prompt\": STORY_SYSTEM_PROMPT.format(\n                n_stories=N_STORIES_PER_CALL, topic=TOPICS_100[ti], emotion=emotion),\n            \"user\": spec[\"prompts\"][\"user_trigger\"],\n            \"seed\": SEED_BASE + ei * 1000 + ti,\n        })\n\n# (2) Neutral dialogues — one call per topic (the baseline contrast).\nfor ti, topic in enumerate(TOPICS_100):\n    jobs.append({\n        \"kind\": \"neutral_dialogue\",\n        \"job_id\": _job_id(\"neutral_dialogue\", spec_hash, ti),\n        \"emotion\": None,\n        \"topic\": topic, \"topic_idx\": ti,\n        \"n_outputs\": N_NEUTRAL_PER_CALL,\n        \"system_prompt\": NEUTRAL_DIALOGUE_SYSTEM_PROMPT.format(\n            n_stories=N_NEUTRAL_PER_CALL, topic=topic),\n        \"user\": spec[\"prompts\"][\"user_trigger\"],\n        \"seed\": SEED_BASE + 900_000 + ti,\n    })\n\n# (3) Optional emotional dialogues for nb08 (hidden-vs-expressed probe).\nif GENERATE_EMOTIONAL_DIALOGUES:\n    for k in range(N_EMOTION_DIALOGUE_PAIRS):\n        pe, ae = rng.choice(EMOTIONS_171), rng.choice(EMOTIONS_171)\n        ti = rng.randrange(len(TOPICS_100))\n        jobs.append({\n            \"kind\": \"emotional_dialogue\",\n            \"job_id\": _job_id(\"emotional_dialogue\", spec_hash, k),\n            \"person_emotion\": pe, \"ai_emotion\": ae,\n            \"topic\": TOPICS_100[ti], \"topic_idx\": ti,\n            \"n_outputs\": N_STORIES_PER_CALL,\n            \"system_prompt\": EMOTIONAL_DIALOGUE_SYSTEM_PROMPT.format(\n                n_stories=N_STORIES_PER_CALL, topic=TOPICS_100[ti],\n                person_emotion=pe, ai_emotion=ae),\n            \"user\": spec[\"prompts\"][\"user_trigger\"],\n            \"seed\": SEED_BASE + 800_000 + k,\n        })\n\n# Stamp every record with provenance so a stray prompts.jsonl is self-describing.\nfor j in jobs:\n    j[\"spec_hash\"] = spec_hash\n    j[\"generator_model\"] = GENERATOR_MODEL\n\nprompts_path = DATA_DIR / \"prompts.jsonl\"\nwith prompts_path.open(\"w\", encoding=\"utf-8\") as f:\n    for j in jobs:\n        f.write(json.dumps(j, ensure_ascii=False) + \"\\n\")\n\nkind_counts = Counter(j[\"kind\"] for j in jobs)\nmanifest = {\n    \"spec_hash\": spec_hash,\n    \"generator_model\": GENERATOR_MODEL,\n    \"n_jobs\": len(jobs),\n    \"n_outputs_expected\": sum(j[\"n_outputs\"] for j in jobs),\n    \"kind_counts\": dict(kind_counts),\n    \"prompts_file\": str(prompts_path),\n}\n(DATA_DIR / \"prompts_manifest.json\").write_text(json.dumps(manifest, indent=2))\n\nprint(f\"wrote {len(jobs):,} prompt jobs → {prompts_path}\")\nfor k, c in sorted(kind_counts.items()):\n    print(f\"  {k:<20} {c:>5} jobs\")\nprint(f\"expected total outputs: {manifest['n_outputs_expected']:,}\")\nprint()\nprint(\"─ example job (truncated) ─\")\nex = dict(jobs[0]); ex[\"system_prompt\"] = ex[\"system_prompt\"][:160] + \" …\"\nprint(json.dumps(ex, indent=2))\n",
